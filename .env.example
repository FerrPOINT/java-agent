# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=java_agent
DB_USER=project_workflow
DB_PASSWORD=change-me

# ── LLM Model ──
AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=sk-change-me
AGENT_MODEL_NAME=gpt-4o
AGENT_MODEL_MAX_TOKENS=4096
AGENT_MODEL_TIMEOUT_SECONDS=600
AGENT_MODEL_MAX_RETRIES=2

# ── Auxiliary Model (optional) ──
AGENT_AUXILIARY_ENABLED=false
AGENT_AUXILIARY_PROVIDER=
AGENT_AUXILIARY_BASE_URL=
AGENT_AUXILIARY_API_KEY=
AGENT_AUXILIARY_MODEL_NAME=

# ── Server ──
AGENT_SERVER_PORT=8090

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=change-me
BOT_SERVER_PORT=8091
BOT_MODE=polling
BOT_BACKEND_URL=http://localhost:8090
BOT_AGENT_NAME=Java Agent
BOT_HEARTBEAT_INTERVAL=30

# ── Memory ──
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_CHAR_LIMIT=8000

# ── Skills ──
AGENT_SKILLS_ENABLED=true

# ── Browser/Chromium ──
AGENT_CHROMIUM_AUTO_START=false
AGENT_CHROMIUM_AUTO_INSTALL=false
AGENT_BROWSER_CDP_URL=http://localhost:9222

# ── Security ──
AGENT_SECURITY_REDACT_ENABLED=true
AGENT_SECURITY_REDACT_SECRETS=true
AGENT_SECURITY_REDACT_PII=true

# ── MCP ──
AGENT_MCP_ENABLED=true

# ── Compression ──
AGENT_COMPRESSION_ENABLED=true

# ── Checkpoints ──
AGENT_CHECKPOINTS_ENABLED=true

# ── Vision ──
AGENT_VISION_PROVIDER=openai
AGENT_VISION_API_KEY=
AGENT_VISION_MODEL_NAME=gpt-4o

# ── TTS ──
AGENT_TTS_ENABLED=false
AGENT_TTS_PROVIDER=openai
AGENT_TTS_API_KEY=
AGENT_TTS_VOICE=alloy

# ── Image Generation ──
AGENT_IMAGE_GEN_ENABLED=false
AGENT_IMAGE_GEN_PROVIDER=openai
AGENT_IMAGE_GEN_API_KEY=
AGENT_IMAGE_GEN_MODEL=dall-e-3

# ── Transcription ──
AGENT_TRANSCRIPTION_ENABLED=false
AGENT_TRANSCRIPTION_PROVIDER=openai
AGENT_TRANSCRIPTION_API_KEY=
AGENT_TRANSCRIPTION_MODEL=whisper-1

# ── Cron ──
AGENT_CRON_ENABLED=true

# ── Curator ──
AGENT_CURATOR_ENABLED=true

# ── Delegation ──
AGENT_DELEGATION_ENABLED=true