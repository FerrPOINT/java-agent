 class ReleaseVerifyTest(unittest.TestCase):
+    def test_missing_docker_context_refuses_before_running_gates(self) -> None:
+        verify = load_module("release_verify_context", "release_verify.py")
+        with patch.object(sys, "argv", ["release_verify.py"]):
+            with self.assertRaises(SystemExit) as failure:
+                verify.parse_args()
+        self.assertEqual(2, failure.exception.code)
+
+    def test_no_docker_gates_does_not_require_a_context(self) -> None:
+        verify = load_module("release_verify_local", "release_verify.py")
+        with patch.object(sys, "argv", ["release_verify.py", "--skip-slow"]):
+            self.assertIsNone(verify.parse_args().docker_context)
+        with patch.object(sys, "argv", ["release_verify.py", "--skip-slow", "--run-docker-e2e"]):
+            with self.assertRaises(SystemExit):
+                verify.parse_args()
+
+    def test_run_command_forwards_only_selected_context_without_changing_parent(self) -> None:
+        verify = load_module("release_verify_selected_context", "release_verify.py")
+        previous = os.environ.get("SDLC_DOCKER_CONTEXT")
+        result = verify.run_command("context", [sys.executable, "-c",
+            "import os; assert os.environ['SDLC_DOCKER_CONTEXT'] == 'isolated-fixture'"],
+            10, {"SDLC_DOCKER_CONTEXT": "isolated-fixture"})
+        self.assertEqual("PASS", result.status)
+        self.assertEqual(previous, os.environ.get("SDLC_DOCKER_CONTEXT"))
+
