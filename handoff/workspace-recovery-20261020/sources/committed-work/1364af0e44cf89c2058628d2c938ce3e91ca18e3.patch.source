diff --git a/docs/architecture/adr/ADR-010-testcontainers.md b/docs/architecture/adr/ADR-010-testcontainers.md
index 5da0146f..98162be2 100644
--- a/docs/architecture/adr/ADR-010-testcontainers.md
+++ b/docs/architecture/adr/ADR-010-testcontainers.md
@@ -2,13 +2,16 @@
 
 | | |
 |---|---|
-| **Status** | Accepted |
+| **Status** | Superseded by [ADR-016](ADR-016-compose-integration-tests.md) |
 | **Date** | 2025-08-12 |
 | **Deciders** | Project lead |
 | **Tags** | testing, integration, postgresql |
 
 ## Context
 
+Historical decision. Current PostgreSQL tests use an explicitly owned Compose
+project on PostgreSQL 17.6; Testcontainers dependencies have been removed.
+
 The default test profile uses H2 in PostgreSQL compatibility mode. This is fast (milliseconds startup) and runs all 5000+ tests quickly. However, H2 does not perfectly replicate PostgreSQL behavior:
 
 - JSONB and array types differ.
diff --git a/docs/architecture/adr/ADR-016-compose-integration-tests.md b/docs/architecture/adr/ADR-016-compose-integration-tests.md
new file mode 100644
index 00000000..d1f7f8c8
--- /dev/null
+++ b/docs/architecture/adr/ADR-016-compose-integration-tests.md
@@ -0,0 +1,29 @@
+# ADR-016: Owned Compose PostgreSQL integration tests
+
+Status: Accepted. Date: 2026-10-04. Supersedes ADR-010.
+
+Slow integration tests require PostgreSQL 17.6 in a unique `sdlc-qa-*` project.
+`scripts/run_postgres_tests.py` selects an explicit Docker context, records the
+daemon identity, creates disposable storage and supplies JDBC settings to the
+Gradle process. Spring test contexts share that explicitly selected database;
+tests must clean their own fixtures. The historical `PostgresTestContainer`
+class name remains as a compatibility entry point and launches no containers.
+
+The required environment is `SDLC_TEST_COMPOSE_PROJECT`,
+`SDLC_TEST_DATABASE_URL`, `SDLC_TEST_DATABASE_USER` and
+`SDLC_TEST_DATABASE_PASSWORD`. Missing settings or a non-QA project/database
+fail before connecting. No fallback to an installed workspace is permitted.
+
+Run from the repository root with a checked-out, pinned Base source:
+
+```sh
+python3 scripts/run_postgres_tests.py --docker-context default \
+  --base-directory ../services-base -- ./backend/gradlew -p backend slowTest --no-daemon
+```
+
+The wrapper removes only its own containers and verifies project/task/purpose
+labels before deleting its disposable PostgreSQL volume in `finally`.
+Protected manifests and the cleanup journal remain under ignored `.local`.
+Credentials and test database contents are excluded from published artifacts.
+Ordinary H2 tests remain separate. PostgreSQL-specific regression tests belong
+to `slowTest`; CI runs the complete task through this wrapper.
diff --git a/docs/plans/2026-10-04-unification-completion.md b/docs/plans/2026-10-04-unification-completion.md
new file mode 100644
index 00000000..140ca224
--- /dev/null
+++ b/docs/plans/2026-10-04-unification-completion.md
@@ -0,0 +1,7 @@
+# План унификации — 4 октября 2026
+
+Работа выполняется в отдельной task ветке. Закрываем Docker/naming, readiness собственной БД и схемы, request correlation, воспроизводимость сборки и UI contract/acceptance без доменных миграций. Существующие маршруты и wire formats совместимы; данные, secrets, snapshots и работающие контейнеры не меняются.
+
+Проверки: обязательные gates репозитория, PostgreSQL 17.6 в собственном временном Compose проекте, отрицательные HTTP/readiness contracts, выбранные workspace profiles, browser evidence после фиксации исходников. Изменения Base потребляются по exact SHA. Merge/deploy выполняются отдельно. Средства проверки не запускают production agents или внешние dispatch.
+
+Приёмка: окончательные task SHA проверены, результаты отражены в PR и обезличенном отчёте Base. Непроверенные пункты не отмечаются завершёнными.
diff --git a/scripts/deploy-dev-docker.sh b/scripts/deploy-dev-docker.sh
index ffc6d08f..e5bfe1d9 100755
--- a/scripts/deploy-dev-docker.sh
+++ b/scripts/deploy-dev-docker.sh
@@ -1,31 +1,67 @@
 #!/usr/bin/env bash
-# Build and run the dev agent in containers with no source-tree bind mount.
+# Legacy Linux-only isolated dev drill. Installed workspaces use Base startup.
 set -euo pipefail
 
 ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
-COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ROOT/.env" -f "$ROOT/docker-compose.dev.yml")
-NETWORK="java-agent-runtime"
-DB_CONTAINER="java-agent-pg"
+: "${SDLC_DOCKER_CONTEXT:?Select the deployment Docker endpoint}"
+: "${SDLC_COMPOSE_PROJECT:?Select the deployment Compose project}"
+: "${SDLC_QA_ENV_FILE:?Select an explicit synthetic QA environment}"
+case "$SDLC_COMPOSE_PROJECT" in
+  sdlc-qa-*|sdlc-build-*) ;;
+  *) echo "Installed workspaces must use the Base root launcher." >&2; exit 1 ;;
+esac
+export SDLC_COMPOSE_PROJECT
+: "${SDLC_TASK:?Explicit QA owner task required}"
+: "${SDLC_PURPOSE:?Explicit QA purpose required}"
+export SDLC_TASK SDLC_PURPOSE
+BASE_DIR="${SDLC_BASE_DIR:-${ROOT}/../services-base}"
+test -f "$BASE_DIR/scripts/compose_probe.py"
+COMPOSE=(docker --context "$SDLC_DOCKER_CONTEXT" compose -p "$SDLC_COMPOSE_PROJECT" --project-directory "$ROOT" --env-file "$SDLC_QA_ENV_FILE" -f "$ROOT/docker-compose.dev.yml")
+: "${SDLC_DEV_NETWORK:?Select the owned QA network}"
+: "${SDLC_POSTGRES_CONTAINER:?Select the owned QA PostgreSQL container}"
+export SDLC_DEV_NETWORK
+NETWORK="$SDLC_DEV_NETWORK"
+DB_CONTAINER="$SDLC_POSTGRES_CONTAINER"
 
 require_container() {
-    if ! docker inspect "$1" >/dev/null 2>&1; then
+    if ! docker --context "$SDLC_DOCKER_CONTEXT" inspect "$1" >/dev/null 2>&1; then
         echo "Required container '$1' does not exist; refusing to create a replacement database." >&2
         exit 1
     fi
 }
 
 require_container "$DB_CONTAINER"
-docker network create "$NETWORK" >/dev/null 2>&1 || true
-docker network connect --alias db "$NETWORK" "$DB_CONTAINER" >/dev/null 2>&1 || true
+owner="$(docker --context "$SDLC_DOCKER_CONTEXT" inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$DB_CONTAINER")"
+test "$owner" = "$SDLC_COMPOSE_PROJECT" || { echo "Foreign database refuses QA deployment." >&2; exit 1; }
+network_owner="$(docker --context "$SDLC_DOCKER_CONTEXT" network inspect --format '{{index .Labels "com.docker.compose.project"}}' "$NETWORK")"
+network_task="$(docker --context "$SDLC_DOCKER_CONTEXT" network inspect --format '{{index .Labels "sdlc.task"}}' "$NETWORK")"
+network_purpose="$(docker --context "$SDLC_DOCKER_CONTEXT" network inspect --format '{{index .Labels "sdlc.purpose"}}' "$NETWORK")"
+test "$network_owner" = "$SDLC_COMPOSE_PROJECT" && test "$network_task" = "$SDLC_TASK" && test "$network_purpose" = "$SDLC_PURPOSE" || { echo "Foreign QA network." >&2; exit 1; }
+cleanup() { "${COMPOSE[@]}" down --remove-orphans; }
+# Refuse shared/foreign resources before cleanup or any write.
+for id in $(docker --context "$SDLC_DOCKER_CONTEXT" ps -aq --filter "label=com.docker.compose.project=$SDLC_COMPOSE_PROJECT"); do
+    task="$(docker --context "$SDLC_DOCKER_CONTEXT" inspect --format '{{index .Config.Labels "sdlc.task"}}' "$id")"
+    purpose="$(docker --context "$SDLC_DOCKER_CONTEXT" inspect --format '{{index .Config.Labels "sdlc.purpose"}}' "$id")"
+    test "$task" = "$SDLC_TASK" && test "$purpose" = "$SDLC_PURPOSE" || {
+        echo "Foreign resource blocks disposable deployment." >&2; exit 1;
+    }
+done
+trap cleanup EXIT
 
 # Ensure named runtime volumes are owned by the unprivileged application user.
-for volume in java_agent_state java_agent_workspace java_agent_tmp; do
-    docker run --rm -v "${ROOT##*/}_${volume}:/volume" alpine:3.22 chown -R 10001:10001 /volume
+for volume in java_agent_state java_agent_chromium java_agent_workspace java_agent_tmp; do
+    volume_name="$("${COMPOSE[@]}" config --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["volumes"][sys.argv[1]]["name"])' "$volume")"
+    docker --context "$SDLC_DOCKER_CONTEXT" volume inspect "$volume_name" >/dev/null
+    owner="$(docker --context "$SDLC_DOCKER_CONTEXT" volume inspect --format '{{index .Labels "com.docker.compose.project"}}' "$volume_name")"
+    task="$(docker --context "$SDLC_DOCKER_CONTEXT" volume inspect --format '{{index .Labels "sdlc.task"}}' "$volume_name")"
+    purpose="$(docker --context "$SDLC_DOCKER_CONTEXT" volume inspect --format '{{index .Labels "sdlc.purpose"}}' "$volume_name")"
+    test "$owner" = "$SDLC_COMPOSE_PROJECT" && test "$task" = "$SDLC_TASK" && test "$purpose" = "$SDLC_PURPOSE" || { echo "Foreign QA volume." >&2; exit 1; }
+    python3 "$BASE_DIR/scripts/compose_probe.py" --context "$SDLC_DOCKER_CONTEXT" \
+      --task "$SDLC_TASK" --purpose "$SDLC_PURPOSE" -- \
+      --volume "${volume_name}:/volume" alpine:3.22 chown -R 10001:10001 /volume
 done
 
-# The host services have unrestricted /opt/dev/java-agent access. Stop them
-# before the container claims their localhost ports and Telegram polling token.
-systemctl stop java-agent-bot.service java-agent-backend.service
+# Existing host services are outside this disposable drill and remain untouched.
 
 "${COMPOSE[@]}" up -d --build --remove-orphans
 
@@ -37,7 +73,7 @@ for _ in $(seq 1 30); do
 done
 curl -fsS --max-time 30 http://127.0.0.1:8090/actuator/health/readiness >/dev/null
 
-backend_id="$("${COMPOSE[@]}" ps -q backend)"
+backend_id="$("${COMPOSE[@]}" ps -q java-agent-backend)"
 bot_id="$("${COMPOSE[@]}" ps -q bot)"
 for id in "$backend_id" "$bot_id"; do
     if [ -z "$id" ]; then
@@ -48,22 +84,22 @@ for id in "$backend_id" "$bot_id"; do
 done
 
 for _ in $(seq 1 30); do
-    [ "$(docker inspect -f '{{.State.Health.Status}}' "$bot_id")" = "healthy" ] && break
+    [ "$(docker --context "$SDLC_DOCKER_CONTEXT" inspect -f '{{.State.Health.Status}}' "$bot_id")" = "healthy" ] && break
     sleep 2
 done
-if [ "$(docker inspect -f '{{.State.Health.Status}}' "$bot_id")" != "healthy" ]; then
+if [ "$(docker --context "$SDLC_DOCKER_CONTEXT" inspect -f '{{.State.Health.Status}}' "$bot_id")" != "healthy" ]; then
     echo "Telegram bot did not become healthy." >&2
     "${COMPOSE[@]}" logs --tail=100 bot
     exit 1
 fi
 curl -fsS --max-time 60 http://127.0.0.1:8090/actuator/health >/dev/null
-docker exec "$bot_id" curl -fsS http://localhost:8091/bot/health >/dev/null
+docker --context "$SDLC_DOCKER_CONTEXT" exec "$bot_id" curl -fsS http://localhost:8091/bot/health >/dev/null
 
 # A base image may contain an empty /root, but the host's agent state and source
 # tree must never be present or accessible from either runtime container.
 for id in "$backend_id" "$bot_id"; do
     for forbidden in /opt/dev/java-agent /root/.hermes /root/.java-agent; do
-        if docker exec "$id" test -e "$forbidden"; then
+        if docker --context "$SDLC_DOCKER_CONTEXT" exec "$id" test -e "$forbidden"; then
             echo "Isolation check failed: $id can access $forbidden" >&2
             exit 1
         fi
diff --git a/scripts/e2e-docker-compose-test.sh b/scripts/e2e-docker-compose-test.sh
index 4d57553e..8eab5940 100755
--- a/scripts/e2e-docker-compose-test.sh
+++ b/scripts/e2e-docker-compose-test.sh
@@ -3,7 +3,16 @@ set -euo pipefail
 
 PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 COMPOSE_FILE="${PROJECT_ROOT}/docker-compose.e2e.yml"
-AGENT_URL="http://localhost:18090"
+: "${SDLC_DOCKER_CONTEXT:?select the Docker context explicitly}"
+export SDLC_TASK_ID="${SDLC_TASK_ID:-java-e2e}"
+PROJECT="sdlc-qa-java-e2e-$(python3 -c 'import uuid; print(uuid.uuid4().hex[:12])')"
+COMPOSE=(docker --context "${SDLC_DOCKER_CONTEXT}" compose -p "${PROJECT}" -f "${COMPOSE_FILE}")
+VOLUME="${PROJECT}_java_agent_e2e_pg"
+if [[ -n "$(docker --context "${SDLC_DOCKER_CONTEXT}" ps -aq --filter "label=com.docker.compose.project=${PROJECT}")" ]] ||
+   docker --context "${SDLC_DOCKER_CONTEXT}" volume inspect "${VOLUME}" >/dev/null 2>&1; then
+    echo "Refusing an existing QA project or volume" >&2
+    exit 1
+fi
 E2E_API_KEY="e2e-only-api-key-not-a-secret"
 MAX_WAIT=180
 PASSED=0
@@ -17,21 +26,32 @@ NC='\033[0m'
 
 function cleanup() {
     echo -e "${YELLOW}[e2e]${NC} Cleaning up Docker Compose..."
-    docker compose -f "${COMPOSE_FILE}" down -v || true
+    "${COMPOSE[@]}" down --remove-orphans || return 1
+    if docker --context "${SDLC_DOCKER_CONTEXT}" volume inspect "${VOLUME}" >/dev/null 2>&1; then
+        local owner task purpose
+        owner="$(docker --context "${SDLC_DOCKER_CONTEXT}" volume inspect "${VOLUME}" --format '{{index .Labels "com.docker.compose.project"}}')"
+        task="$(docker --context "${SDLC_DOCKER_CONTEXT}" volume inspect "${VOLUME}" --format '{{index .Labels "sdlc.task"}}')"
+        purpose="$(docker --context "${SDLC_DOCKER_CONTEXT}" volume inspect "${VOLUME}" --format '{{index .Labels "sdlc.purpose"}}')"
+        if [[ "${owner}" != "${PROJECT}" || "${task}" != "${SDLC_TASK_ID}" || "${purpose}" != "java-e2e" ]]; then
+            echo "Foreign QA volume; cleanup refused" >&2
+            return 1
+        fi
+        docker --context "${SDLC_DOCKER_CONTEXT}" volume rm "${VOLUME}" >/dev/null
+    fi
 }
 trap cleanup EXIT
 
 function pass() {
     local name=$1
     echo -e "${GREEN}[e2e] PASS${NC}: ${name}"
-    ((PASSED++))
+    ((PASSED+=1))
 }
 
 function fail() {
     local name=$1
     local reason=$2
     echo -e "${RED}[e2e] FAIL${NC}: ${name} — ${reason}"
-    ((FAILED++))
+    ((FAILED+=1))
 }
 
