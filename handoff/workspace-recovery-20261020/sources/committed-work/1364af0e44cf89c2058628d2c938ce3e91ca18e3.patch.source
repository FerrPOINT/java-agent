diff --git a/scripts/run_postgres_tests.py b/scripts/run_postgres_tests.py
new file mode 100644
index 00000000..30b0b5b7
--- /dev/null
+++ b/scripts/run_postgres_tests.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""Run slow tests against PostgreSQL owned by a disposable Compose project."""
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import re
+import secrets
+import subprocess
+import uuid
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--docker-context', required=True)
+    parser.add_argument('--base-directory', type=Path)
+    parser.add_argument('command', nargs=argparse.REMAINDER)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    base = args.base_directory or root.parent / 'services-base'
+    spec = importlib.util.spec_from_file_location('compose_helpers', base / 'scripts/compose_helpers.py')
+    helpers = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(helpers)
+    project = 'sdlc-qa-java-postgres-' + uuid.uuid4().hex[:12]
+    docker = ['docker', '--context', args.docker_context]
+    labels = {'sdlc.task': 'platform-unification', 'sdlc.purpose': 'java-postgres-integration'}
+    password = secrets.token_hex(24)
+    directory = root / '.local' / project
+    helper = helpers.ComposeHelper(project=project, task=labels['sdlc.task'], purpose=labels['sdlc.purpose'],
+                                   docker=docker, directory=directory)
+    volume = project + '_postgres-data'
+    created = False
+    try:
+        helper.write({'postgres': {'image': 'postgres:17.6-alpine',
+            'environment': {'POSTGRES_DB': 'sdlc_qa_java', 'POSTGRES_USER': 'test', 'POSTGRES_PASSWORD': password},
+            'ports': [{'target': 5432, 'published': '0', 'host_ip': '127.0.0.1'}],
+            'volumes': [{'type': 'volume', 'source': 'postgres-data', 'target': '/var/lib/postgresql/data'}],
+            'healthcheck': {'test': ['CMD', 'pg_isready', '-U', 'test', '-d', 'sdlc_qa_java'],
+                            'interval': '1s', 'timeout': '3s', 'retries': 30}}},
+            volumes={'postgres-data': {'labels': labels}})
+        created = True
+        helpers.checked(helper.command + ['up', '-d', '--wait', '--wait-timeout', '60'])
+        port = helpers.checked(helper.command + ['port', 'postgres', '5432'], text=True).strip()
+        if not re.fullmatch(r'127\.0\.0\.1:[0-9]+', port):
+            raise RuntimeError('Unexpected QA PostgreSQL endpoint')
+        environment = dict(os.environ, SDLC_TEST_COMPOSE_PROJECT=project,
+            SDLC_TEST_DATABASE_URL='jdbc:postgresql://' + port + '/sdlc_qa_java',
+            SDLC_TEST_DATABASE_USER='test', SDLC_TEST_DATABASE_PASSWORD=password)
+        environment.update(USAGE_PERSISTENCE_TEST_JDBC_URL=environment['SDLC_TEST_DATABASE_URL'],
+            USAGE_PERSISTENCE_TEST_DB_USER='test', USAGE_PERSISTENCE_TEST_DB_PASSWORD=password)
+        command = args.command[1:] if args.command[:1] == ['--'] else args.command
+        command = command or [str(root / ('gradlew.bat' if os.name == 'nt' else 'gradlew')), ':backend:slowTest', '--no-daemon']
+        return subprocess.run(command, cwd=root, env=environment).returncode
+    finally:
+        helper.close()
+        if created:
+            import json
+            existing = helpers.checked(docker + ['volume', 'ls', '--format', '{{.Name}}'], text=True).splitlines()
+            if volume in existing:
+                data = json.loads(helpers.checked(docker + ['volume', 'inspect', volume], text=True))[0]
+                found = data.get('Labels') or {}
+                if found.get('com.docker.compose.project') != project or any(found.get(k) != v for k, v in labels.items()):
+                    raise RuntimeError('Foreign volume blocks QA cleanup')
+                helpers.checked(docker + ['volume', 'rm', volume])
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
