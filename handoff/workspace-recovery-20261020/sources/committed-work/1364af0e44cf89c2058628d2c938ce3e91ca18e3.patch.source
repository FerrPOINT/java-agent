diff --git a/backend/src/test/java/com/azhukov/agent/api/filter/RequestIdFilterTest.java b/backend/src/test/java/com/azhukov/agent/api/filter/RequestIdFilterTest.java
new file mode 100644
index 00000000..cf4b92e9
--- /dev/null
+++ b/backend/src/test/java/com/azhukov/agent/api/filter/RequestIdFilterTest.java
@@ -0,0 +1,40 @@
+package com.azhukov.agent.api.filter;
+
+import org.junit.jupiter.api.Test;
+import org.slf4j.MDC;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class RequestIdFilterTest {
+    @Test
+    void preservesUuidAndCorrelatesRejectedResponse() throws Exception {
+        var request = new MockHttpServletRequest();
+        var response = new MockHttpServletResponse();
+        var id = UUID.randomUUID().toString();
+        request.addHeader(RequestIdFilter.HEADER, id);
+        new RequestIdFilter().doFilter(request, response, (incoming, outgoing) -> {
+            assertThat(MDC.get("request_id")).isEqualTo(id);
+            ((jakarta.servlet.http.HttpServletResponse) outgoing).setStatus(403);
+        });
+        assertThat(response.getStatus()).isEqualTo(403);
+        assertThat(response.getHeader(RequestIdFilter.HEADER)).isEqualTo(id);
+        assertThat(MDC.get("request_id")).isNull();
+    }
+
+    @Test
+    void replacesUntrustedHeaderAndRetainsIdOnException() {
+        var request = new MockHttpServletRequest();
+        var response = new MockHttpServletResponse();
+        request.addHeader(RequestIdFilter.HEADER, "log-injection");
+        org.assertj.core.api.Assertions.assertThatThrownBy(() ->
+            new RequestIdFilter().doFilter(request, response, (incoming, outgoing) -> {
+                throw new jakarta.servlet.ServletException("fixture");
+            })).isInstanceOf(jakarta.servlet.ServletException.class);
+        assertThat(UUID.fromString(response.getHeader(RequestIdFilter.HEADER))).isNotNull();
+        assertThat(MDC.get("request_id")).isNull();
+    }
+}
diff --git a/backend/src/test/java/com/azhukov/agent/health/StorageReadinessHealthIndicatorTest.java b/backend/src/test/java/com/azhukov/agent/health/StorageReadinessHealthIndicatorTest.java
new file mode 100644
index 00000000..a7ada99f
--- /dev/null
+++ b/backend/src/test/java/com/azhukov/agent/health/StorageReadinessHealthIndicatorTest.java
@@ -0,0 +1,79 @@
+package com.azhukov.agent.health;
+
+import org.flywaydb.core.Flyway;
+import org.flywaydb.core.api.MigrationInfo;
+import org.flywaydb.core.api.MigrationInfoService;
+import org.flywaydb.core.api.MigrationState;
+import org.flywaydb.core.api.output.ValidateResult;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.EnumSource;
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.boot.health.contributor.Status;
+
+import javax.sql.DataSource;
+import java.sql.Connection;
+import java.util.concurrent.CountDownLatch;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+class StorageReadinessHealthIndicatorTest {
+    @SuppressWarnings("unchecked")
+    @ParameterizedTest
+    @EnumSource(value = MigrationState.class, names = {"PENDING", "FUTURE_SUCCESS", "MISSING_SUCCESS", "FAILED", "IGNORED"})
+    void rejectsIncompatibleMigrationWithoutExecutingMigrate(MigrationState incompatible) throws Exception {
+        var source = mock(DataSource.class);
+        var connection = mock(Connection.class);
+        when(source.getConnection()).thenReturn(connection);
+        when(connection.isValid(2)).thenReturn(true);
+        var statement = mock(java.sql.Statement.class);
+        when(connection.createStatement()).thenReturn(statement);
+        when(statement.executeQuery(anyString())).thenReturn(mock(java.sql.ResultSet.class));
+        var flyway = mock(Flyway.class);
+        var result = new ValidateResult("synthetic", "qa", null, true, 0, java.util.List.of(), java.util.List.of());
+        when(flyway.validateWithResult()).thenReturn(result);
+        var info = mock(MigrationInfoService.class);
+        when(flyway.info()).thenReturn(info);
+        var migration = mock(MigrationInfo.class);
+        when(migration.getState()).thenReturn(incompatible);
+        when(info.all()).thenReturn(new MigrationInfo[]{migration});
+        ObjectProvider<Flyway> provider = mock(ObjectProvider.class);
+        when(provider.getIfAvailable()).thenReturn(flyway);
+        try (var probe = new StorageReadinessHealthIndicator(source, provider)) {
+            assertThat(probe.health().getStatus()).isEqualTo(Status.DOWN);
+            when(migration.getState()).thenReturn(MigrationState.SUCCESS);
+            assertThat(probe.health().getStatus()).isEqualTo(Status.UP);
+            verify(flyway, never()).migrate();
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    @Test
+    void blockedAcquisitionIsBoundedAndRepeatedProbesDoNotQueue() throws Exception {
+        var source = mock(DataSource.class);
+        var release = new CountDownLatch(1);
+        when(source.getConnection()).thenAnswer(invocation -> {
+            boolean done = false;
+            while (!done) {
+                try { release.await(); done = true; } catch (InterruptedException ignored) { }
+            }
+            throw new java.sql.SQLException("private credential sentinel");
+        });
+        ObjectProvider<Flyway> provider = mock(ObjectProvider.class);
+        var probe = new StorageReadinessHealthIndicator(source, provider);
+        try {
+            long started = System.nanoTime();
+            var health = probe.health();
+            assertThat(health.getStatus()).isEqualTo(Status.DOWN);
+            assertThat((System.nanoTime() - started) / 1_000_000).isLessThan(4000);
+            assertThat(probe.health().getDetails()).containsEntry("reason", "probe busy");
+            verify(source, times(1)).getConnection();
+            assertThat(health.getDetails().toString()).doesNotContain("sentinel");
+        } finally {
+            release.countDown();
+            probe.close();
+        }
+    }
+
+}
diff --git a/backend/src/test/java/com/azhukov/agent/persistence/PostgresTestContainer.java b/backend/src/test/java/com/azhukov/agent/persistence/PostgresTestContainer.java
