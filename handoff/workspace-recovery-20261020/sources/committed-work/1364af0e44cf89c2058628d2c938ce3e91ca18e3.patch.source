diff --git a/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilter.java b/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilter.java
new file mode 100644
index 00000000..90e2c2ca
--- /dev/null
+++ b/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilter.java
@@ -0,0 +1,63 @@
+package com.azhukov.agent.api.filter;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import lombok.extern.slf4j.Slf4j;
+import org.slf4j.MDC;
+import org.springframework.core.Ordered;
+import org.springframework.core.annotation.Order;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+import java.io.IOException;
+import java.util.UUID;
+
+@Slf4j
+@Component
+@Order(Ordered.HIGHEST_PRECEDENCE)
+public class RequestIdFilter extends OncePerRequestFilter {
+    public static final String HEADER = "X-Request-Id";
+
+    static String requestId(String supplied) {
+        if (supplied != null && supplied.matches("[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}")) {
+            return supplied;
+        }
+        return UUID.randomUUID().toString();
+    }
+
+    @Override
+    protected boolean shouldNotFilterErrorDispatch() {
+        return false;
+    }
+
+    @Override
+    protected boolean shouldNotFilterAsyncDispatch() {
+        return false;
+    }
+
+    @Override
+    protected void doFilterNestedErrorDispatch(HttpServletRequest request, HttpServletResponse response,
+                                              FilterChain chain) throws ServletException, IOException {
+        doFilterInternal(request, response, chain);
+    }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response,
+                                    FilterChain chain) throws ServletException, IOException {
+        String id = request.getAttribute(HEADER) instanceof String previous ? previous : requestId(request.getHeader(HEADER));
+        request.setAttribute(HEADER, id);
+        response.setHeader(HEADER, id);
+        String previous = MDC.get("request_id");
+        MDC.put("request_id", id);
+        long started = System.nanoTime();
+        try {
+            chain.doFilter(request, response);
+        } finally {
+            log.info("request_id={} method={} path={} status={} elapsed_ms={}", id, request.getMethod(),
+                request.getRequestURI(), response.getStatus(), (System.nanoTime() - started) / 1_000_000);
+            if (previous == null) MDC.remove("request_id"); else MDC.put("request_id", previous);
+        }
+    }
+}
diff --git a/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilterConfiguration.java b/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilterConfiguration.java
new file mode 100644
index 00000000..551ba6c5
--- /dev/null
+++ b/backend/src/main/java/com/azhukov/agent/api/filter/RequestIdFilterConfiguration.java
@@ -0,0 +1,22 @@
+package com.azhukov.agent.api.filter;
+
+import jakarta.servlet.DispatcherType;
+import org.springframework.boot.web.servlet.FilterRegistrationBean;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.core.Ordered;
+
+import java.util.EnumSet;
+
+/** Preserve correlation when the servlet container dispatches an error or SSE continuation. */
+@Configuration(proxyBeanMethods = false)
+public class RequestIdFilterConfiguration {
+    @Bean
+    FilterRegistrationBean<RequestIdFilter> requestIdFilterRegistration(RequestIdFilter filter) {
+        var registration = new FilterRegistrationBean<>(filter);
+        registration.setOrder(Ordered.HIGHEST_PRECEDENCE);
+        registration.setAsyncSupported(true);
+        registration.setDispatcherTypes(EnumSet.of(DispatcherType.REQUEST, DispatcherType.ASYNC, DispatcherType.ERROR));
+        return registration;
+    }
+}
diff --git a/backend/src/main/java/com/azhukov/agent/health/StorageReadinessHealthIndicator.java b/backend/src/main/java/com/azhukov/agent/health/StorageReadinessHealthIndicator.java
new file mode 100644
index 00000000..13f107cd
--- /dev/null
+++ b/backend/src/main/java/com/azhukov/agent/health/StorageReadinessHealthIndicator.java
@@ -0,0 +1,96 @@
+package com.azhukov.agent.health;
+
+import jakarta.annotation.PreDestroy;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.flywaydb.core.Flyway;
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.health.contributor.Health;
+import org.springframework.boot.health.contributor.HealthIndicator;
+import org.springframework.stereotype.Component;
+
+import javax.sql.DataSource;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Semaphore;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Read-only, bounded connectivity and migration validation for readiness only. */
+@Slf4j
+@Component
+@RequiredArgsConstructor
+public class StorageReadinessHealthIndicator implements HealthIndicator, AutoCloseable {
+    private final DataSource dataSource;
+    private final ObjectProvider<Flyway> flyway;
+    private final Semaphore active = new Semaphore(1);
+    private final java.util.concurrent.ExecutorService executor =
+        Executors.newSingleThreadExecutor(Thread.ofVirtual().name("storage-readiness").factory());
+
+    @Value("${spring.flyway.enabled:true}")
+    private boolean migrationsEnabled = true;
+
+    @Override
+    public Health health() {
+        // A timed-out JDBC operation retains its permit until it actually exits.
+        // Repeated probes cannot queue work or exhaust the business pool.
+        if (!active.tryAcquire()) {
+            return Health.down().withDetail("reason", "probe busy").build();
+        }
+        var state = new AtomicInteger();
+        var result = executor.submit(() -> {
+            if (!state.compareAndSet(0, 1)) {
+                return Health.down().withDetail("reason", "probe cancelled").build();
+            }
+            try {
+                try (var connection = dataSource.getConnection()) {
+                    if (!connection.isValid(2)) {
+                        return Health.down().withDetail("reason", "database unavailable").build();
+                    }
+                    if (migrationsEnabled) {
+                        try (var statement = connection.createStatement()) {
+                            statement.setQueryTimeout(2);
+                            try (var ignored = statement.executeQuery("SELECT user_id FROM bot_sessions LIMIT 0")) {
+                                // Planning verifies required schema without reading user rows.
+                            }
+                        }
+                    }
+                }
+                if (migrationsEnabled) {
+                    var migrations = flyway.getIfAvailable();
+                    if (migrations == null || !migrations.validateWithResult().validationSuccessful) {
+                        return Health.down().withDetail("reason", "schema incompatible").build();
+                    }
+                    for (var migration : migrations.info().all()) {
+                        switch (migration.getState()) {
+                            case SUCCESS, OUT_OF_ORDER, BASELINE, BELOW_BASELINE -> { }
+                            default -> { return Health.down().withDetail("reason", "schema incompatible").build(); }
+                        }
+                    }
+                }
+                return Health.up().build();
+            } catch (Exception error) {
+                log.warn("Storage readiness failed ({})", error.getClass().getSimpleName());
+                return Health.down().withDetail("reason", "storage unavailable").build();
+            } finally {
+                active.release();
+            }
+        });
+        try {
+            return result.get(2, TimeUnit.SECONDS);
+        } catch (Exception error) {
+            result.cancel(true);
+            if (state.compareAndSet(0, 2)) active.release();
+            if (error instanceof InterruptedException) {
+                Thread.currentThread().interrupt();
+            }
+            return Health.down().withDetail("reason", "probe timeout").build();
+        }
+    }
+
+    @PreDestroy
+    @Override
+    public void close() {
+        executor.shutdownNow();
+    }
+}
