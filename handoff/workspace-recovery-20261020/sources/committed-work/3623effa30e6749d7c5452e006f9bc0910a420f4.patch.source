+        "технолог(?:ии|ий|ия|ию|иями|иях)?|(?<!\\p{L})ит(?!\\p{L})|телеком|data|(?<![\\p{L}\\p{N}])ai(?![\\p{L}\\p{N}])|цифров|беспилот|электробатар|программ"
     );
 
