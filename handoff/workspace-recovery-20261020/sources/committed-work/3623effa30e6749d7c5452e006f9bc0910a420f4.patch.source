+        "january", "february", "march", "april", "may", "june", "july", "august", "september", "october", "november", "december",
+        "январь", "января", "январе", "февраль", "февраля", "феврале", "март", "марта", "марте",
+        "апрель", "апреля", "апреле", "май", "мая", "мае", "июнь", "июня", "июне",
