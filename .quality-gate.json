{
  "schema": "base-quality-product/v1",
  "product": "java-agent",
  "native_execution": {
    "adapter": "java-compose-v1",
    "host_platforms": ["win32"],
    "cli_max_workers": 3,
    "gates": {
      "backend:unit": {"component": "backend", "role": "unit"},
      "backend:build": {"component": "backend", "role": "build"},
      "bot:unit": {"component": "bot", "role": "unit"},
      "bot:build": {"component": "bot", "role": "build"},
      "cli:unit": {"component": "cli", "role": "unit"},
      "cli:build": {"component": "cli", "role": "build"},
      "shared:unit": {"component": "shared", "role": "unit"}
    }
  },
  "components": {
    "docs": [
      "docs/**",
      "*.md",
      "LICENSE"
    ],
    "tooling": [
      "Makefile",
      "java-artifacts.json",
      ".quality-tooling-revision",
      "scripts/vendor/**",
      "scripts/quality-make.sh",
      "scripts/quality-gradle.sh",
      "scripts/ci_quality_plan.py",
      "scripts/check_test_lanes.py",
      "scripts/gradle-context.py",
      "scripts/release_verify.py",
      "scripts/endpoint_coverage_report.py",
      "scripts/check_default_settings_reference.py",
      "scripts/tests/test_quality_adoption.py",
      "scripts/tests/test_test_lanes.py",
      "scripts/tests/test_gradle_context.py",
      "scripts/tests/test_quality_root_graph.py",
      "scripts/tests/test_release_verify.py",
      "scripts/tests/test_source_sets_native.py",
      "scripts/tests/test_check_default_settings_reference.py"
    ],
    "backend": [
      "backend/**"
    ],
    "bot": [
      "telegram-bot/**"
    ],
    "cli": [
      "cli/**"
    ],
    "shared": [
      "shared/**",
      "build.gradle",
      "gradle.properties",
      "gradle/**",
      ".github/**"
    ]
  },
  "gates": [
    {
      "id": "tooling:release-verifier-unit",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "release"
      ],
      "test_tier": "unit",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_release_verify",
        "-q"
      ],
      "inputs": [
        ".quality-gate.json",
        "scripts/release_verify.py",
        "scripts/endpoint_coverage_report.py",
        "scripts/tests/test_release_verify.py",
        "scripts/vendor/base_quality_selection.py",
        ".github/workflows/ci.yml",
        ".github/workflows/release.yml"
      ],
      "cacheable": false,
      "execution_slot": "none"
    },
    {
      "id": "tooling:release-verifier-protocol",
      "component": "tooling",
      "profiles": [
        "integration"
      ],
      "test_tier": "integration",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_release_verify.ReleaseVerifyProtocolTest",
        "-q"
      ],
      "inputs": [
        "scripts/release_verify.py",
        "scripts/quality-gradle.sh",
        "scripts/tests/test_release_verify.py"
      ],
      "cacheable": false
    },
    {
      "id": "tooling:source-sets-native",
      "component": "tooling",
      "profiles": [
        "integration"
      ],
      "test_tier": "integration",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_source_sets_native",
        "-q"
      ],
      "inputs": [
        "gradle/test-lanes.gradle",
        "scripts/tests/test_source_sets_native.py",
        "gradle/test-topology.gradle",
        "gradle/test-membership.gradle"
      ],
      "requires_env": [
        "PDLC_GRADLE_HOME",
        "JAVA_HOME"
      ],
      "external_state": true,
      "cacheable": false
    },
    {
      "id": "tooling:test-lane-inventory",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "release"
      ],
      "test_tier": "static",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_test_lanes.py"
      ],
      "inputs": [
        "gradle/test-lanes.json",
        "gradle/test-lanes.gradle",
        "*/src/test/**",
        "scripts/check_test_lanes.py",
        "gradle/test-topology.gradle",
        "gradle/test-membership.gradle"
      ],
      "cacheable": true,
      "execution_slot": "none"
    },
    {
      "id": "tooling:partition-source-unit",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_test_lanes",
        "scripts.tests.test_gradle_context",
        "scripts.tests.test_quality_root_graph",
        "scripts.tests.test_quality_adoption",
        "scripts.tests.test_check_default_settings_reference",
        "-q"
      ],
      "inputs": [
        "gradle/**",
        "scripts/**",
        ".quality-gate.json",
        ".github/**",
        "*/build.gradle",
        "*/src/test/**",
        "settings.gradle",
        "Makefile",
        "Dockerfile*",
        "*/Dockerfile"
      ],
      "test_tier": "unit",
      "execution_slot": "none",
      "cacheable": false
    },
    {
      "id": "docs:readme",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_readme.py"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":test",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1",
          "context_argv": [
            "{python}",
            "scripts/gradle-context.py",
            "--backend"
          ],
          "cwd": ".",
          "context_pattern": "\"java_version\":\"25\\.0\\.4\\.1\"",
          "reuse_pattern": "\"reuse_qualified\":true",
          "recheck": true
        }
      ],
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "source_date_epoch": "git-head",
      "test_tier": "unit",
      "outputs": [
        "backend/build/test-results/test"
      ]
    },
    {
      "id": "backend:build",
      "component": "backend",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":bootJar",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "backend/src/main/**",
        "shared/src/main/**",
        "shared/*.gradle",
        "shared/gradle.properties",
        "backend/gradlew",
        "backend/*.gradle",
        "backend/gradle.properties",
        "backend/gradle/**",
        "*.gradle",
        "gradle.properties",
        "gradle/**",
        "scripts/quality-gradle.sh",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
        "scripts/gradle-context.py"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1",
          "context_argv": [
            "{python}",
            "scripts/gradle-context.py",
            "--backend"
          ],
          "cwd": ".",
          "context_pattern": "\"java_version\":\"25\\.0\\.4\\.1\"",
          "reuse_pattern": "\"reuse_qualified\":true",
          "recheck": true
        }
      ],
      "kind": "artifact",
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "source_date_epoch": "git-head",
      "test_tier": "artifact",
      "covers_units": [
        "backend:unit"
      ],
      "outputs": [
        "backend/build/libs/java-agent-backend-0.0.1-SNAPSHOT.jar"
      ]
    },
