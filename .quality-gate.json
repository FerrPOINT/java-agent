{
  "schema": "base-quality-product/v1",
  "product": "java-agent",
  "native_execution": {
    "adapter": "java-compose-v1",
    "host_platforms": ["win32"],
    "gates": {
      "backend:unit": {"component": "backend", "role": "unit"},
      "backend:build": {"component": "backend", "role": "build"},
      "bot:unit": {"component": "bot", "role": "unit"},
      "cli:unit": {"component": "cli", "role": "unit"},
      "shared:unit": {"component": "shared", "role": "unit"}
    }
  },
  "components": {
    "docs": [
      "docs/**",
      "*.md",
      "LICENSE"
    ],
    "tooling": [
      "Makefile",
      "scripts/quality-make.sh",
      "Dockerfile",
      "Dockerfile.slim",
      "telegram-bot/Dockerfile",
      "cli/Dockerfile",
      "scripts/tests/test_quality_gradle.py",
      "scripts/gradle-context.py",
      "scripts/tests/test_gradle_context.py",
      "scripts/tests/test_dependency_inputs.py",
      "gradle/quality-inputs.gradle",
      "gradle/test-lanes.gradle",
      "gradle/test-lanes.json",
      "scripts/tests/test_source_sets_native.py",
      "gradle/java-preparation.json",
      "java-artifacts.json",
      "scripts/check_test_lanes.py",
      "scripts/tests/test_test_lanes.py",
      "scripts/tests/test_deploy_dev_docker.py",
      "scripts/deploy-dev-docker.sh",
      "docker-compose.dev.yml"
    ],
    "backend": [
      "backend/**"
    ],
    "bot": [
      "telegram-bot/**"
    ],
    "cli": [
      "cli/**"
    ],
    "shared": [
      "shared/**",
      "build.gradle",
      "gradle.properties",
      "gradle/**",
      ".github/**"
    ]
  },
  "gates": [
    {
      "id": "tooling:source-sets-native",
      "component": "tooling",
      "profiles": ["integration"],
      "test_tier": "integration",
      "argv": ["{python}", "-B", "-m", "unittest", "scripts.tests.test_source_sets_native", "-q"],
      "inputs": ["gradle/test-lanes.gradle", "scripts/tests/test_source_sets_native.py"],
      "requires_env": ["PDLC_GRADLE_HOME", "JAVA_HOME"],
      "external_state": true,
      "cacheable": false
    },
    {
      "id": "tooling:test-lane-inventory",
      "component": "tooling",
      "profiles": ["fast", "unit", "build", "release"],
      "test_tier": "static",
      "argv": ["{python}", "-B", "scripts/check_test_lanes.py"],
      "inputs": ["gradle/test-lanes.json", "gradle/test-lanes.gradle", "*/src/test/**", "scripts/check_test_lanes.py"],
      "cacheable": true
    },
    {
      "id": "docs:readme",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_readme.py"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "tooling:dependency-inputs-unit",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "release"
      ],
      "test_tier": "unit",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_dependency_inputs",
        "-q"
      ],
      "inputs": [
        "gradle/quality-inputs.gradle",
        "gradle/java-preparation.json",
        "java-artifacts.json",
        "backend/build.gradle",
        "shared/build.gradle",
        "cli/build.gradle",
        "telegram-bot/build.gradle",
        "Dockerfile",
        "Dockerfile.slim",
        "scripts/tests/test_dependency_inputs.py"
      ],
      "cacheable": true,
      "execution_slot": "none"
    },
    {
      "id": "tooling:gradle-helper-unit",
      "component": "tooling",
      "profiles": ["fast", "unit", "build", "release"],
      "test_tier": "unit",
      "argv": ["{python}", "-B", "-m", "unittest", "scripts.tests.test_quality_gradle", "scripts.tests.test_gradle_context", "scripts.tests.test_deploy_dev_docker", "scripts.tests.test_test_lanes", "-q"],
      "inputs": ["Makefile", "scripts/quality-make.sh", "scripts/quality-gradle.sh", "scripts/tests/test_quality_gradle.py", "scripts/check_test_lanes.py", "scripts/tests/test_test_lanes.py", "scripts/tests/test_deploy_dev_docker.py", "scripts/deploy-dev-docker.sh", "docker-compose.dev.yml", "Dockerfile", "Dockerfile.slim", "telegram-bot/Dockerfile", "cli/Dockerfile", "gradle/wrapper/gradle-wrapper.properties", "backend/gradle/wrapper/gradle-wrapper.properties", "scripts/gradle-context.py", "scripts/tests/test_gradle_context.py"],
      "cacheable": true,
      "execution_slot": "none"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":test",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1",
          "context_argv": [
            "{python}",
            "scripts/gradle-context.py",
            "--backend"
          ],
          "cwd": ".",
          "context_pattern": "\"java_version\":\"25\\.0\\.4\\.1\"",
          "reuse_pattern": "\"reuse_qualified\":true",
          "recheck": true
        }
      ],
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "source_date_epoch": "git-head",
      "test_tier": "unit",
      "outputs": ["backend/build/test-results/test"]
    },
