        "./gradlew",
        "--no-daemon",
        "--max-workers=2",
        ":cli:bootJar"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1"
        }
      ],
      "kind": "artifact",
      "test_tier": "artifact",
      "outputs": [
        "cli/build/libs/cli-0.0.1-SNAPSHOT.jar"
      ]
    },
    {
      "id": "bot:build",
      "component": "bot",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "./gradlew",
        "--no-daemon",
        "--max-workers=2",
        ":telegram-bot:bootJar"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1"
        }
      ],
      "kind": "artifact",
      "test_tier": "artifact",
      "outputs": [
        "telegram-bot/build/libs/telegram-bot-0.0.1-SNAPSHOT.jar"
      ]
    },
    {
      "id": "tooling:coverage-ratchet",
      "component": "tooling",
      "profiles": [
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/check_docs_standard.py",
        "--check-coverage"
      ],
      "inputs": [
        "scripts/check_docs_standard.py",
        "docs/standards/coverage-baseline.json"
      ],
      "external_state": true,
      "cacheable": false,
      "test_tier": "integration"
    }
  ],
  "additional_acceptance": "Existing product CI/CONTRIBUTING: MSRV/features, ignored DB, OpenAPI/packed consumer/themes, security and live acceptance remain separate mandatory gates where applicable.",
  "backend_unit_inputs": [
    "backend/src/test/**",
    "backend/src/slowTest/**",
    "shared/src/test/**",
    "telegram-bot/src/test/**",
    "cli/src/test/**"
  ],
  "impacts": [
    {
      "paths": [
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "components": [
        "backend",
        "bot",
        "cli",
        "shared"
      ]
    },
    {
      "paths": [
        "*.gradle",
        "*.gradle.kts",
        "gradle.properties",
        "gradle/**",
        "scripts/quality-gradle.sh",
        "scripts/gradle-context.py",
        "shared/src/main/**",
        "shared/build.gradle",
        "shared/settings.gradle",
        "shared/gradle.properties"
      ],
      "components": [
        "backend",
        "bot",
        "cli",
        "shared",
        "tooling"
      ]
    }
  ]
}
