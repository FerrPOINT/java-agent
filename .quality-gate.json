{
  "schema": "base-quality-product/v1",
  "product": "java-agent",
  "components": {
    "docs": [
      "docs/**",
      "*.md",
      "LICENSE"
    ],
    "tooling": [
      "Dockerfile",
      "Dockerfile.slim",
      "telegram-bot/Dockerfile",
      "cli/Dockerfile",
      "scripts/tests/test_quality_gradle.py",
      "scripts/tests/test_deploy_dev_docker.py",
      "scripts/deploy-dev-docker.sh",
      "docker-compose.dev.yml"
    ],
    "backend": [
      "backend/**"
    ],
    "bot": [
      "telegram-bot/**"
    ],
    "cli": [
      "cli/**"
    ],
    "shared": [
      "shared/**",
      "build.gradle",
      "gradle.properties",
      "gradle/**",
      ".github/**"
    ]
  },
  "gates": [
    {
      "id": "docs:readme",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_readme.py"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "tooling:gradle-helper-unit",
      "component": "tooling",
      "profiles": ["fast", "unit", "build", "release"],
      "test_tier": "unit",
      "argv": ["{python}", "-B", "-m", "unittest", "scripts.tests.test_quality_gradle", "scripts.tests.test_deploy_dev_docker", "-q"],
      "inputs": ["scripts/quality-gradle.sh", "scripts/tests/test_quality_gradle.py", "scripts/tests/test_deploy_dev_docker.py", "scripts/deploy-dev-docker.sh", "docker-compose.dev.yml", "Dockerfile", "Dockerfile.slim", "telegram-bot/Dockerfile", "cli/Dockerfile", "gradle/wrapper/gradle-wrapper.properties", "backend/gradle/wrapper/gradle-wrapper.properties"],
      "cacheable": true
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":test",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1"
        }
      ],
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "test_tier": "unit"
    },
    {
      "id": "backend:build",
      "component": "backend",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":bootJar",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "backend/src/main/**",
        "shared/src/main/**",
        "backend/*.gradle",
        "backend/gradle.properties",
        "backend/gradle/**",
        "*.gradle",
        "gradle.properties",
        "gradle/**",
        "scripts/quality-gradle.sh",
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1"
        }
      ],
      "kind": "artifact",
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "test_tier": "artifact"
    },
