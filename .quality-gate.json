{
  "schema": "base-quality-product/v1",
  "product": "java-agent",
  "native_execution": {
    "adapter": "java-compose-v1",
    "host_platforms": [
      "win32"
    ],
    "gates": {
      "backend:unit": {
        "component": "backend",
        "role": "unit"
      },
      "backend:build": {
        "component": "backend",
        "role": "build"
      },
      "bot:unit": {
        "component": "bot",
        "role": "unit"
      },
      "cli:unit": {
        "component": "cli",
        "role": "unit"
      },
      "shared:unit": {
        "component": "shared",
        "role": "unit"
      },
      "cli:build": {
        "component": "cli",
        "role": "build"
      },
      "bot:build": {
        "component": "bot",
        "role": "build"
      }
    }
  },
  "components": {
    "docs": [
      "docs/**",
      "*.md"
    ],
    "tooling": [
      "Makefile",
      ".quality-gate.json",
      "java-artifacts.json",
      ".quality-tooling-revision",
      ".github/workflows/ci.yml",
      "Dockerfile",
      "Dockerfile.slim",
      "cli/Dockerfile",
      "telegram-bot/Dockerfile",
      "gradle/test-lanes.json",
      "gradle/test-lanes.gradle",
      "scripts/select_java_modules.py",
      "scripts/quality-gradle.sh",
      "scripts/quality-make.sh",
      "scripts/gradle-context.py",
      "scripts/check_docs_standard.py",
      "scripts/verify_readme.py",
      "scripts/check_default_settings_reference.py",
      "scripts/release_verify.py",
      "scripts/endpoint_coverage_report.py",
      "scripts/check_test_lanes.py",
      "scripts/deploy-dev-systemd.sh",
      "scripts/deploy-dev-docker.sh",
      "scripts/parity-dashboard.py",
      "scripts/vendor/base_quality_selection.py",
      "scripts/vendor/base-quality-tooling.json",
      "scripts/tests/test_java_selection.py",
      "scripts/tests/test_test_lanes.py",
      "scripts/tests/test_source_sets_native.py",
      "scripts/tests/test_check_docs_standard.py",
      "scripts/tests/test_verify_readme.py",
      "scripts/tests/test_check_default_settings_reference.py",
      "scripts/tests/test_release_verify.py",
      "scripts/tests/test_deploy_dev_systemd.py",
      "scripts/tests/test_deploy_dev_docker.py",
      "scripts/tests/test_parity_dashboard.py"
    ],
    "backend": [
      "backend/**"
    ],
    "bot": [
      "telegram-bot/**"
    ],
    "cli": [
      "cli/**"
    ],
    "shared": [
      "shared/**",
      "build.gradle",
      "gradle.properties",
      "gradle/**",
      ".github/**"
    ]
  },
  "gates": [
    {
      "id": "tooling:unit",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_java_selection",
        "scripts.tests.test_test_lanes",
        "scripts.tests.test_release_verify",
        "scripts.tests.test_check_docs_standard",
        "scripts.tests.test_verify_readme",
        "scripts.tests.test_check_default_settings_reference",
        "-q"
      ],
      "cwd": ".",
      "inputs": [
        "gradle/test-lanes.json",
        "gradle/test-lanes.gradle",
        "*/src/test/**",
        "scripts/check_test_lanes.py",
        "gradle/test-topology.gradle",
        "gradle/test-membership.gradle",
        ".quality-gate.json",
        "scripts/vendor/**",
        "scripts/select_java_modules.py",
        "scripts/tests/test_java_selection.py",
        "scripts/check_docs_standard.py",
        "scripts/verify_readme.py",
        "scripts/check_default_settings_reference.py",
        "scripts/release_verify.py",
        "scripts/tests/test_test_lanes.py",
        "scripts/tests/test_release_verify.py",
        "scripts/tests/test_check_docs_standard.py",
        "scripts/tests/test_verify_readme.py",
        "scripts/tests/test_check_default_settings_reference.py",
        "backend/src/test/**",
        "telegram-bot/src/test/**",
        "cli/src/test/**",
        "shared/src/test/**"
      ],
      "cacheable": false,
      "execution_slot": "none",
      "test_tier": "unit"
    },
    {
      "id": "tooling:source-sets-native",
      "component": "tooling",
      "profiles": [
        "integration"
      ],
      "test_tier": "integration",
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_source_sets_native",
        "-q"
      ],
      "inputs": [
        "gradle/test-lanes.gradle",
        "scripts/tests/test_source_sets_native.py",
        "gradle/test-topology.gradle",
        "gradle/test-membership.gradle"
      ],
      "requires_env": [
        "PDLC_GRADLE_HOME",
        "JAVA_HOME"
      ],
      "external_state": true,
      "cacheable": false
    },
    {
      "id": "docs:readme",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_readme.py"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "scripts/quality-gradle.sh",
        "--backend",
        ":test",
        "--no-daemon",
        "--max-workers=2"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "java",
            "-version"
          ],
          "pattern": "25\\.0\\.4\\.1",
          "context_argv": [
            "{python}",
            "scripts/gradle-context.py",
            "--backend"
          ],
          "cwd": ".",
          "context_pattern": "\"java_version\":\"25\\.0\\.4\\.1\"",
          "reuse_pattern": "\"reuse_qualified\":true",
          "recheck": true
        }
      ],
      "environment_inputs": [
        "SOURCE_DATE_EPOCH"
      ],
      "source_date_epoch": "git-head",
      "test_tier": "unit",
      "outputs": [
        "backend/build/test-results/test"
      ]
    },
    {
