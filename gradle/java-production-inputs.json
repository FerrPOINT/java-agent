{
  "schema": "base-java-production-source/v1",
  "common": [
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "gradle/build-info.gradle",
    "gradle/ferrpoint-notices.gradle",
    "gradle/quality-inputs.gradle",
    "gradle/production/settings.gradle",
    "gradle/production/project.gradle"
  ],
  "wrappers": {
